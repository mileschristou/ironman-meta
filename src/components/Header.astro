---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/progression/', label: 'Progression' },
  { href: '/skilling/', label: 'Skilling' },
  { href: '/supplies/', label: 'Supplies' },
  { href: '/guides/', label: 'Guides' },
];

const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="header">
  <div class="header-ornament header-ornament-left"></div>
  <div class="header-ornament header-ornament-right"></div>
  <div class="header-container">
    <a href="/" class="logo">
      <span class="logo-icon">⚔</span>
      <span class="logo-text">Ironman<span class="logo-accent">Meta</span></span>
    </a>

    <button
      class="mobile-menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span class="hamburger"></span>
    </button>

    <nav class="nav" aria-label="Main navigation">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.95) 0%,
      rgba(18, 18, 18, 0.92) 50%,
      rgba(15, 13, 10, 0.90) 100%
    );
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    border-bottom: 1px solid var(--color-border);
    box-shadow:
      0 1px 0 0 rgba(212, 165, 116, 0.1) inset,
      0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-accent-dim) 20%,
      var(--color-accent) 50%,
      var(--color-accent-dim) 80%,
      transparent 100%
    );
    opacity: 0.5;
  }

  /* Decorative corner ornaments */
  .header-ornament {
    position: absolute;
    top: 12px;
    width: 24px;
    height: 24px;
    border: 1px solid var(--color-border);
    pointer-events: none;
    opacity: 0.6;
    transition: opacity var(--transition-slow), border-color var(--transition-slow);
  }

  .header-ornament-left {
    left: 12px;
    border-right: none;
    border-bottom: none;
  }

  .header-ornament-right {
    right: 12px;
    border-left: none;
    border-bottom: none;
  }

  .header:hover .header-ornament {
    opacity: 1;
    border-color: var(--color-accent-dim);
  }

  .header-container {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    transition: transform var(--transition-normal);
  }

  .logo:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .logo-icon {
    font-size: 1.5rem;
    filter: drop-shadow(0 0 8px var(--color-accent-glow));
    transition: filter var(--transition-normal);
  }

  .logo:hover .logo-icon {
    filter: drop-shadow(0 0 12px var(--color-accent-glow)) drop-shadow(0 0 4px var(--color-accent));
  }

  .logo-text {
    color: var(--color-text-bright);
    transition: color var(--transition-normal);
  }

  .logo:hover .logo-text {
    color: var(--color-accent-bright);
  }

  .logo-accent {
    color: var(--color-accent);
    text-shadow: 0 0 20px var(--color-accent-glow);
  }

  .nav-list {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    padding: var(--space-xs) var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color var(--transition-normal);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: var(--space-sm);
    right: var(--space-sm);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    opacity: 0;
    transform: scaleX(0);
    transition: opacity var(--transition-normal), transform var(--transition-normal);
  }

  .nav-link:hover {
    color: var(--color-accent-bright);
    text-decoration: none;
  }

  .nav-link:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link.active::after {
    opacity: 0.6;
    transform: scaleX(1);
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-sm);
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    position: relative;
    transition: background-color var(--transition-fast);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    transition: transform var(--transition-fast);
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { bottom: -7px; }

  /* Mobile styles */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: block;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: linear-gradient(
        180deg,
        rgba(15, 13, 10, 0.98) 0%,
        rgba(18, 18, 18, 0.95) 100%
      );
      backdrop-filter: blur(12px) saturate(150%);
      -webkit-backdrop-filter: blur(12px) saturate(150%);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
      display: none;
    }

    .nav.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
      padding: var(--space-md);
    }

    .nav-link {
      display: block;
      padding: var(--space-md);
    }

    /* Hamburger animation when open */
    .mobile-menu-toggle[aria-expanded="true"] .hamburger {
      background-color: transparent;
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger::before {
      transform: translateY(7px) rotate(45deg);
    }

    .mobile-menu-toggle[aria-expanded="true"] .hamburger::after {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.mobile-menu-toggle');
  const nav = document.querySelector('.nav');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    nav?.classList.toggle('open');
  });
</script>
