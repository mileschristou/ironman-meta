---
// Turael Skip Tool - Interactive teleport recommender
---

<div class="turael-tool" id="turaelTool">
  <!-- Setup Panel -->
  <div class="setup-panel">
    <h3 class="panel-title">Your Setup</h3>

    <!-- Spellbook -->
    <div class="unlock-group">
      <h4 class="group-title">Spellbook</h4>
      <div class="radio-group">
        <label class="radio-label">
          <input type="radio" name="spellbook" value="normal" checked />
          <span>Normal</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="spellbook" value="lunar" />
          <span>Lunar (NPC Contact)</span>
        </label>
      </div>
    </div>

    <!-- Teleport Items -->
    <div class="unlock-group">
      <h4 class="group-title">Teleport Items</h4>
      <div class="checkbox-grid">
        <label class="check-label"><input type="checkbox" data-unlock="games_necklace" checked /><span>Games Necklace</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="ring_of_dueling" checked /><span>Ring of Dueling</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="glory" checked /><span>Amulet of Glory</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="combat_bracelet" /><span>Combat Bracelet</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="skills_necklace" /><span>Skills Necklace</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="slayer_ring" /><span>Slayer Ring</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="xerics_talisman" /><span>Xeric's Talisman</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="ectophial" /><span>Ectophial</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="skull_sceptre" /><span>Skull Sceptre</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="digsite_pendant" /><span>Digsite Pendant</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="royal_seed_pod" /><span>Royal Seed Pod</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="chronicle" /><span>Chronicle</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="cowbell_amulet" /><span>Cowbell Amulet</span></label>
      </div>
    </div>

    <!-- Access & Diaries -->
    <div class="unlock-group">
      <h4 class="group-title">Access & Diaries</h4>
      <div class="checkbox-grid">
        <label class="check-label"><input type="checkbox" data-unlock="fairy_rings" /><span>Fairy Rings</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="no_dramen" /><span>No Dramen Staff Needed</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="house_tabs" /><span>House Tabs</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="poh_jewellery_box" /><span>POH Jewellery Box</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="poh_fairy_ring" /><span>POH Fairy Ring</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="ardougne_cloak" /><span>Ardougne Cloak 1+</span></label>
        <label class="check-label"><input type="checkbox" data-unlock="desert_amulet_4" /><span>Desert Amulet 4</span></label>
      </div>
    </div>
  </div>

  <!-- Results Panel -->
  <div class="results-panel">
    <!-- Recommended Inventory -->
    <div class="inventory-section">
      <h3 class="panel-title">Recommended Inventory</h3>
      <div class="inv-grid" id="inventoryGrid"></div>
      <div class="inventory-note" id="inventoryNote"></div>
    </div>

    <!-- Task Reference -->
    <div class="task-section">
      <h3 class="panel-title">Task Quick Reference</h3>
      <div class="task-table-wrapper">
        <table class="task-table" id="taskTable">
          <thead>
            <tr>
              <th>Task</th>
              <th>Speed</th>
              <th>Best Teleport</th>
              <th>Alternate</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody id="taskTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  .turael-tool {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  @media (max-width: 900px) {
    .turael-tool {
      grid-template-columns: 1fr;
    }
  }

  .panel-title {
    margin: 0 0 1rem 0;
    font-size: 1.125rem;
    color: var(--color-accent, #d4a574);
    font-weight: 600;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-bg-elevated, #1a1612);
  }

  /* Setup Panel */
  .setup-panel {
    background: var(--color-bg-secondary, #121212);
    border: 1px solid var(--color-bg-elevated, #1a1612);
    border-radius: 0.5rem;
    padding: 1.25rem;
    align-self: start;
    position: sticky;
    top: 1rem;
  }

  @media (max-width: 900px) {
    .setup-panel {
      position: static;
    }
  }

  .unlock-group {
    margin-bottom: 1.25rem;
  }

  .unlock-group:last-child {
    margin-bottom: 0;
  }

  .group-title {
    margin: 0 0 0.5rem 0;
    font-size: 0.8rem;
    color: var(--color-text-muted, #8a7a6a);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .radio-label,
  .check-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--color-text, #e5d5c0);
    transition: background-color 0.15s ease;
  }

  .radio-label:hover,
  .check-label:hover {
    background-color: var(--color-bg-elevated, #1a1612);
  }

  .checkbox-grid {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .check-label input,
  .radio-label input {
    accent-color: var(--color-accent, #d4a574);
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  /* Results Panel */
  .results-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .inventory-section {
    background: var(--color-bg-secondary, #121212);
    border: 1px solid var(--color-bg-elevated, #1a1612);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }

  .inv-grid {
    display: grid;
    grid-template-columns: repeat(4, 44px);
    gap: 2px;
    background: #241810;
    border: 3px solid #5a4020;
    border-radius: 6px;
    padding: 5px;
    width: fit-content;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.6);
  }

  .inv-slot {
    width: 44px;
    height: 44px;
    background: #130c04;
    border: 1px solid #2a1c0a;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .inv-slot.filled {
    cursor: help;
    background: #1a1008;
  }

  .inv-slot.filled.essential {
    box-shadow: inset 0 0 0 1px var(--color-accent, #d4a574);
  }

  .inv-slot img {
    max-width: 36px;
    max-height: 36px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .inv-slot.no-img::after {
    content: attr(data-name);
    font-size: 0.45rem;
    color: #b8986f;
    text-align: center;
    line-height: 1.2;
    padding: 2px;
    word-break: break-word;
  }

  .inventory-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-text-muted, #8a7a6a);
    line-height: 1.5;
  }

  /* Task Table */
  .task-section {
    background: var(--color-bg-secondary, #121212);
    border: 1px solid var(--color-bg-elevated, #1a1612);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }

  .task-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .task-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .task-table th {
    text-align: left;
    padding: 0.625rem 0.75rem;
    background-color: var(--color-bg-elevated, #1a1612);
    color: var(--color-accent, #d4a574);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.7rem;
    border-bottom: 2px solid #3d2f1f;
    white-space: nowrap;
  }

  .task-table td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-bg-elevated, #1a1612);
    color: var(--color-text, #e5d5c0);
    vertical-align: top;
  }

  .task-table tbody tr:hover {
    background-color: var(--color-bg-elevated, #1a1612);
  }

  .task-name {
    font-weight: 600;
    white-space: nowrap;
  }

  .task-name .slayer-req {
    font-size: 0.7rem;
    color: var(--color-text-muted, #8a7a6a);
    font-weight: 400;
  }

  .teleport-text {
    color: var(--color-accent-bright, #e8c294);
    font-weight: 500;
  }

  .teleport-alt {
    color: var(--color-text-muted, #8a7a6a);
  }

  .task-note {
    font-size: 0.75rem;
    color: var(--color-text-muted, #8a7a6a);
  }

  .task-note.warning {
    color: #e57373;
  }

  .no-teleport {
    color: #8a7a6a;
    font-style: italic;
  }

  .speed-badge {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    border-radius: 0.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .speed-fast {
    background: #2d2010;
    color: #d4a574;
  }

  .speed-medium {
    background: #1a2620;
    color: #7ab894;
  }

  .speed-slow {
    background: #2a1818;
    color: #e57373;
  }
</style>

