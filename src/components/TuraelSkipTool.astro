    { id: 'ice_coolers', name: 'Ice Coolers', img: 'Ice_cooler.png', essential: true, always: true, note: 'Required for Lizards task' },
    { id: 'light_source', name: 'Light Source', img: 'Bullseye_lantern.png', essential: false, always: true, note: 'Cave Bugs and Cave Slime' },
    { id: 'games_necklace', name: 'Games Necklace', img: 'Games_necklace(8).png', essential: false, requires: ['games_necklace'], excludedBy: 'poh_jewellery_box', note: 'Burthorpe return + Wolves/Dwarves' },
    { id: 'ring_of_dueling', name: 'Ring of Dueling', img: 'Ring_of_dueling(8).png', essential: false, requires: ['ring_of_dueling'], excludedBy: 'poh_jewellery_box', note: 'Rats (Ferox) + Scorpions' },
    { id: 'glory', name: 'Amulet of Glory', img: 'Amulet_of_glory(6).png', essential: false, requires: ['glory'], excludedBy: 'poh_jewellery_box', note: 'Edgeville, Al Kharid, Draynor, Karamja' },
    { id: 'combat_bracelet', name: 'Combat Bracelet', img: 'Combat_bracelet(6).png', essential: false, requires: ['combat_bracelet'], excludedBy: 'poh_jewellery_box', note: 'Birds + Icefiends' },
    { id: 'skills_necklace', name: 'Skills Necklace', img: 'Skills_necklace(6).png', essential: false, requires: ['skills_necklace'], excludedBy: 'poh_jewellery_box', note: 'Mining Guild, Crafting Guild' },
    { id: 'slayer_ring', name: 'Slayer Ring', img: 'Slayer_ring(8).png', essential: false, requires: ['slayer_ring'], note: 'Slayer Tower + Fremennik Dungeon' },
    { id: 'xerics_talisman', name: "Xeric's Talisman", img: "Xeric%27s_talisman.png", essential: false, requires: ['xerics_talisman'], note: 'Ghosts (Catacombs) + Bats' },
    { id: 'ectophial', name: 'Ectophial', img: 'Ectophial.png', essential: false, requires: ['ectophial'], note: 'Zombies' },
    { id: 'skull_sceptre', name: 'Skull Sceptre', img: 'Skull_sceptre(i).png', essential: false, requires: ['skull_sceptre'], note: 'Minotaurs' },
    { id: 'digsite_pendant', name: 'Digsite Pendant', img: 'Digsite_pendant(5).png', essential: false, requires: ['digsite_pendant'], note: 'Skeletons' },
    { id: 'royal_seed_pod', name: 'Royal Seed Pod', img: 'Royal_seed_pod.png', essential: false, requires: ['royal_seed_pod'], note: 'Monkeys (Gnome Glider)' },
    { id: 'chronicle', name: 'Chronicle', img: 'Chronicle.png', essential: false, requires: ['chronicle'], note: "Birds (Champions' Guild)" },
    { id: 'cowbell_amulet', name: 'Cowbell Amulet', img: 'Cowbell_amulet.png', essential: false, requires: ['cowbell_amulet'], note: 'Cows, Birds (chickens), and Goblins - three tasks from one tele' },
    { id: 'ardougne_cloak', name: 'Ardougne Cloak', img: 'Ardougne_cloak_1.png', essential: false, requires: ['ardougne_cloak'], note: 'Icefiends (Monastery)' },
    { id: 'desert_amulet_4', name: 'Desert Amulet 4', img: 'Desert_amulet_4.png', essential: false, requires: ['desert_amulet_4'], note: 'Kalphites' },
    { id: 'dramen_staff', name: 'Dramen Staff', img: 'Dramen_staff.png', essential: false, requiresFairyNoStaff: true, note: 'Fairy ring access (weapon slot)' },
  ];

  // ============================================================
  // STATE & LOGIC
  // ============================================================
  function getUnlocks() {
    const unlocks = new Set();
    const spellbook = document.querySelector('input[name="spellbook"]:checked') as HTMLInputElement;
    if (spellbook) {
      if (spellbook.value === 'normal') unlocks.add('standard_spellbook');
      if (spellbook.value === 'lunar') unlocks.add('lunar_spellbook');
    }
    document.querySelectorAll('[data-unlock]').forEach(el => {
      const input = el as HTMLInputElement;
      if (input.checked) unlocks.add(input.dataset.unlock);
    });
    // POH jewellery box implies all jewellery
    if (unlocks.has('poh_jewellery_box')) {
      unlocks.add('games_necklace');
      unlocks.add('ring_of_dueling');
      unlocks.add('glory');
      unlocks.add('combat_bracelet');
      unlocks.add('skills_necklace');
    }
    // POH fairy ring implies no dramen needed
    if (unlocks.has('poh_fairy_ring')) {
      unlocks.add('fairy_rings');
      unlocks.add('no_dramen');
    }
    return unlocks;
  }

  function getBestTeleport(task, unlocks) {
    // If on Lunar, POH-based teleports work via house tabs
    const hasHouseAccess = unlocks.has('house_tabs') || unlocks.has('standard_spellbook');

    for (const tp of task.teleports) {
      const met = tp.requires.every(req => {
        if (req === 'standard_spellbook') {
          // On Lunar, Standard teles still work via POH Portal Nexus or house tabs
          return unlocks.has('standard_spellbook') || (unlocks.has('lunar_spellbook') && unlocks.has('house_tabs') && unlocks.has('poh_jewellery_box'));
        }
        return unlocks.has(req);
      });
      if (met) return tp;
    }
    return null;
  }

  function getAlternateTeleport(task, unlocks, bestTp) {
    for (const tp of task.teleports) {
      if (tp === bestTp) continue;
      const met = tp.requires.every(req => {
        if (req === 'standard_spellbook') {
          return unlocks.has('standard_spellbook') || (unlocks.has('lunar_spellbook') && unlocks.has('house_tabs') && unlocks.has('poh_jewellery_box'));
        }
        return unlocks.has(req);
      });
      if (met) return tp;
    }
    return null;
  }

  function buildInventory(unlocks) {
    const items = [];
    for (const item of INVENTORY_ITEMS) {
      // Dramen staff: only if fairy rings AND no dramen-free access
      if (item.requiresFairyNoStaff !== undefined) {
        if (unlocks.has('fairy_rings') && !unlocks.has('no_dramen') && !unlocks.has('poh_fairy_ring')) {
          items.push(item);
        }
        continue;
      }

      // Always-include items
      if (item.always) {
        items.push(item);
        continue;
      }

      // Check requires
      if (item.requires) {
        const hasAll = item.requires.every(r => unlocks.has(r));
        if (!hasAll) continue;
      }

      // Check excludedBy (e.g., POH jewellery box replaces individual pieces)
      if (item.excludedBy && unlocks.has(item.excludedBy)) continue;

      items.push(item);
    }
    return items;
  }

  function render() {
    const unlocks = getUnlocks();

    // Build inventory
    const inventory = buildInventory(unlocks);
    const gridEl = document.getElementById('inventoryGrid');
    const noteEl = document.getElementById('inventoryNote');
    if (gridEl) {
      const wikiBase = 'https://oldschool.runescape.wiki/images/';
      const slots = inventory.map(item => {
        const cls = `inv-slot filled${item.essential ? ' essential' : ''}`;
        return `<div class="${cls}" title="${item.name}" data-name="${item.name}">
          <img src="${wikiBase}${item.img}" alt="${item.name}"
               onerror="this.parentElement.classList.add('no-img'); this.remove();" />
        </div>`;
      });
      for (let i = inventory.length; i < 28; i++) {
        slots.push('<div class="inv-slot empty"></div>');
      }
      gridEl.innerHTML = slots.join('');
    }

    const remaining = 28 - inventory.length;
    if (noteEl) {
      const spellbookNote = unlocks.has('lunar_spellbook')
        ? 'Lunar: Rune pouch holds Air, Astral, Cosmic for NPC Contact.'
        : 'Normal: Rune pouch holds Law, Air, + Earth/Water/Fire for teleport spells.';
      noteEl.innerHTML = `${inventory.length} slots used - ${remaining} free for combat gear and food.<br>${spellbookNote}`;
    }

    // Build task table
    const tbody = document.getElementById('taskTableBody');
    if (tbody) {
      tbody.innerHTML = TASKS.map(task => {
        const best = getBestTeleport(task, unlocks);
        const alt = getAlternateTeleport(task, unlocks, best);
        const slayerTag = task.slayerReq ? ` <span class="slayer-req">(${task.slayerReq} Slay)</span>` : '';
        const noteClass = task.notes && (task.notes.toLowerCase().includes('required') || task.notes.toLowerCase().includes('poison')) ? 'task-note warning' : 'task-note';

        const speedLabel = task.speed === 'fast' ? 'Fast' : task.speed === 'slow' ? 'Slow' : 'Medium';
        const speedClass = `speed-badge speed-${task.speed}`;

        return `<tr>
          <td><span class="task-name">${task.name}${slayerTag}</span></td>
          <td><span class="${speedClass}">${speedLabel}</span></td>
          <td>${best ? `<span class="teleport-text">${best.label}</span>` : '<span class="no-teleport">No teleport available</span>'}</td>
          <td>${alt ? `<span class="teleport-alt">${alt.label}</span>` : '<span class="teleport-alt">-</span>'}</td>
          <td>${task.notes ? `<span class="${noteClass}">${task.notes}</span>` : ''}</td>
        </tr>`;
      }).join('');
    }
  }

  // ============================================================
  // LOCALSTORAGE PERSISTENCE
  // ============================================================
  const STORAGE_KEY = 'turael-tool-config';

  function saveConfig() {
    try {
      const spellbook = (document.querySelector('input[name="spellbook"]:checked') as HTMLInputElement)?.value || 'normal';
      const checkboxes: Record<string, boolean> = {};
      document.querySelectorAll('[data-unlock]').forEach(el => {
        const input = el as HTMLInputElement;
        checkboxes[input.dataset.unlock!] = input.checked;
      });
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ spellbook, checkboxes }));
    } catch (e) {}
  }

  function loadConfig() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (!stored) return;
      const config = JSON.parse(stored);
      if (config.spellbook) {
        const radio = document.querySelector(`input[name="spellbook"][value="${config.spellbook}"]`) as HTMLInputElement;
        if (radio) radio.checked = true;
      }
      if (config.checkboxes) {
        document.querySelectorAll('[data-unlock]').forEach(el => {
          const input = el as HTMLInputElement;
          const key = input.dataset.unlock!;
          if (config.checkboxes[key] !== undefined) input.checked = config.checkboxes[key];
        });
      }
    } catch (e) {}
  }

  // ============================================================
  // EVENT LISTENERS
  // ============================================================
  document.querySelectorAll('#turaelTool input').forEach(input => {
    input.addEventListener('change', () => { render(); saveConfig(); });
  });

  // Auto-check fairy_rings when poh_fairy_ring is checked
  const pohFairyEl = document.querySelector('[data-unlock="poh_fairy_ring"]') as HTMLInputElement;
  pohFairyEl?.addEventListener('change', () => {
    if (pohFairyEl.checked) {
      const fairyEl = document.querySelector('[data-unlock="fairy_rings"]') as HTMLInputElement;
      if (fairyEl) fairyEl.checked = true;
      const dramenEl = document.querySelector('[data-unlock="no_dramen"]') as HTMLInputElement;
      if (dramenEl) dramenEl.checked = true;
    }
  });

  // Auto-check fairy_rings when no_dramen is checked
  const noDramenEl = document.querySelector('[data-unlock="no_dramen"]') as HTMLInputElement;
  noDramenEl?.addEventListener('change', () => {
    if (noDramenEl.checked) {
      const fairyEl = document.querySelector('[data-unlock="fairy_rings"]') as HTMLInputElement;
      if (fairyEl) fairyEl.checked = true;
    }
  });

  // Load saved config then render
  loadConfig();
  render();
</script>
