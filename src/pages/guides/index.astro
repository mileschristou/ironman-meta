---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const sortedGuides = allGuides.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const subcategories = {
  'regions': {
    title: 'Regions',
    description: 'Region-specific guides: Varlamore, Kourend, Morytania, and more',
  },
  'activities': {
    title: 'Activities',
    description: 'Specific minigames and activities: Giants Foundry, Guardians of the Rift, Tempoross',
  },
  'unlocks': {
    title: 'Unlocks',
    description: 'Quest chains, diaries, and important milestones',
  },
};
---

<BaseLayout
  title="Ironman Content Guides"
  description="In-depth guides for OSRS Ironmen covering regions, activities, and important unlocks. Varlamore, Giants Foundry, and more."
>
  <div class="pillar-page">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Guides' }]} />

      <header class="pillar-header">
        <h1>OSRS Ironman Content Guides</h1>
        <p class="pillar-intro">
          Comprehensive guides for OSRS ironman accounts covering region unlocks, efficient minigame strategies, and critical quest chains. Each guide focuses on ironman-specific methods, timesaving strategies, and long-term account progression.
        </p>

        <div class="guide-benefits">
          <h2>Why These Guides Matter</h2>
          <p>Unlike general OSRS guides, these are written specifically for ironman restrictions. We cover:</p>
          <ul>
            <li><strong>Self-sufficient strategies</strong> - No Grand Exchange shortcuts, only ironman-viable methods</li>
            <li><strong>Efficient unlock orders</strong> - What to prioritize and when based on your account stage</li>
            <li><strong>Time-saving techniques</strong> - Skip the inefficient methods mains use</li>
            <li><strong>Long-term planning</strong> - How each unlock benefits your account for hundreds of hours</li>
          </ul>
        </div>
      </header>

      <section class="subcategories">
        {Object.entries(subcategories).map(([slug, { title, description }]) => (
          <div class="subcategory">
            <h2>{title}</h2>
            <p class="subcategory-description">{description}</p>
            {sortedGuides.filter(g => g.data.subcategory === slug).length > 0 ? (
              <div class="guide-grid">
                {sortedGuides
                  .filter(g => g.data.subcategory === slug)
                  .map((guide) => (
                    <GuideCard
                      title={guide.data.title}
                      description={guide.data.description}
                      href={`/guides/${guide.slug}/`}
                    />
                  ))}
              </div>
            ) : (
              <p class="coming-soon">Guides coming soon.</p>
            )}
          </div>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .pillar-page {
    padding: var(--space-xl) 0;
  }

  .pillar-header {
    margin-bottom: var(--space-2xl);
  }

  .pillar-header h1 {
    margin-bottom: var(--space-md);
  }

  .pillar-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 40rem;
    line-height: 1.6;
  }

  .subcategories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .subcategory h2 {
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .subcategory-description {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .coming-soon {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .guide-benefits {
    background: linear-gradient(135deg, #2d2419 0%, #1a1612 100%);
    border: 2px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--space-xl);
    margin: var(--space-xl) 0;
  }

  .guide-benefits h2 {
    margin-top: 0;
    margin-bottom: var(--space-md);
    color: var(--color-primary);
  }

  .guide-benefits ul {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0 0;
  }

  .guide-benefits li {
    padding: var(--space-sm) 0;
    padding-left: var(--space-md);
    position: relative;
  }

  .guide-benefits li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: bold;
  }
</style>
