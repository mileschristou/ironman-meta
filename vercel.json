{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://ironmanmeta.com/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ironmanmeta.com"
        }
      ],
      "permanent": true
    }
  ]
}
